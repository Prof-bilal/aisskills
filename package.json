{
  "name": "aiskills-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first AI Skills Platform workspace",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "clean": "pnpm -r clean",
    "release:check": "pnpm clean && pnpm install --frozen-lockfile && pnpm build && pnpm test && pnpm -r pack --pack-destination ./release"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
