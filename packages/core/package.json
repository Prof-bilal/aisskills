{
  "name": "aiskills-core",
  "version": "0.2.0-beta.1",
  "description": "Provider-neutral AI Skills runtime contracts and utilities",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Prof-bilal/aisskills.git",
    "directory": "packages/core"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "packs",
    "workflows",
    "tools"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "playwright-core": "^1.64.1",
    "yaml": "^2.8.1"
  }
}
