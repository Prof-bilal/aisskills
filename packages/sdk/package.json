{
  "name": "aiskills-sdk",
  "version": "0.2.0-beta.1",
  "description": "SDK foundations for declarative AI Skills extensions",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "https://github.com/Prof-bilal/aisskills.git", "directory": "packages/sdk" },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "aiskills-core": "workspace:*"
  }
}
